LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx
# Used when /new chat is invoked without a cwd.
LARK_DEFAULT_WORKSPACE=/Users/you/Codes/project
# Optional state directory; defaults to .state in this project.
LARK_STATE_DIR=.state
# Append pi-style cumulative token, cache, cost, and context usage to Agent replies.
LARK_PI_STATUS_ENABLED=true
# Match pi footer's auto-compaction marker. Set false to omit " (auto)".
LARK_PI_STATUS_AUTO_COMPACTION=true
